# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI
GEMINI_API_KEY=your_gemini_api_key

# Payments (Paddle) - web only. The Android build ships free, no billing.
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
# Paddle.js client-side token (browser checkout; NOT the API key / webhook secret)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
# Paddle environment: 'production' or 'sandbox'
NEXT_PUBLIC_PADDLE_ENV=production
# Paddle Billing price IDs (read by src/lib/billing.ts and the checkout)
NEXT_PUBLIC_PADDLE_SUB_PRICE_ID=your_paddle_subscription_price_id
NEXT_PUBLIC_PADDLE_PACK_PRICE_ID=your_paddle_pack_price_id

# Public site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://www.unicornapps.app

# Gemini rate limiter. Plain server env (NOT NEXT_PUBLIC_) so they are read at
# runtime and tunable in Vercel without a rebuild.
#
# THE CEILING IS THE SHARED FREE-TIER GEMINI KEY: 5 RPM / 20 RPD for the WHOLE
# APP, not per user - one key, one quota bucket, every user. Size these against
# CALLS, never request count: one request costs up to MAX_MODEL_ATTEMPTS (=2)
# generateContent calls, so the invariant is limit * 2 <= ceiling. Confirm your
# own project's real RPM/RPD in Google AI Studio before raising anything.
#
# Global caps sit below the ceiling so we 429 locally before Google does;
# per-user caps sit at or below global, for fairness.
#
# The four values below are the in-code fallbacks in src/lib/rate-limit.ts -
# what applies verbatim when a var is unset or non-numeric. They are a
# safe-under-ceiling floor, not a target to run at, and they still clear the
# ceiling at 3 calls per request. Production limits live in Vercel.
RATE_LIMIT_GLOBAL_RPM=1
RATE_LIMIT_GLOBAL_RPD=6
RATE_LIMIT_USER_RPM=1
RATE_LIMIT_USER_RPD=5
